cc_library_shared {
    name: "libsdk_sr_shim",
    srcs: [
        "libsdk_sr_shim.cpp",
    ],
    shared_libs: [
        "libc",
        "liblog",
    ],
    compile_multilib: "64",
    vendor: true,
    ldflags: ["-Wl,-soname,libsdk_sr.so"],
}
