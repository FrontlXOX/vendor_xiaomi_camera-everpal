// Interposer for libmialgoengine.so libsdk_sr.so calls via TARGET_LD_SHIM_LIBS.
cc_library_shared {
    name: "libsdk_sr_shim",
    srcs: [
        "libsdk_sr_shim.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
    compile_multilib: "64",
    vendor: true,
}
