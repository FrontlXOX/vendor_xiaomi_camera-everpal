soong_namespace {
}

android_app_import {
    name: "MiuiCamera",
    owner: "xiaomi",
    apk: "proprietary/system/priv-app/MiuiCamera/MiuiCamera.apk",
    overrides: [
       //"Aperture", 
        "Camera",
        "Camera2",
        "GoogleCameraGo",
    ],
    preprocessed: true,
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
    enforce_uses_libs: false,
    optional_uses_libs: [
        "org.apache.http.legacy",
        "android.test.base",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm64: {
            srcs: ["proprietary/system/lib64/libcamera_algoup_jni.xiaomi.so"],
        },
    },
    compile_multilib: "64",
    system_shared_libs: [],
    check_elf_files: false,
    prefer: true,
}

