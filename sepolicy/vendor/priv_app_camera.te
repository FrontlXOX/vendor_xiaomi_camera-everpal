# Allow MiCamera (priv_app) to find Xiaomi vendor hardware services
# Required for IMiSys and IMiPostProcService on Android 16
allow priv_app default_android_hwservice:hwservice_manager find;


# Required for MiuiCamera / cameraserver to read vendor ISP feature-flag
# property during camera3 device configuration (fixes black viewfinder)
allow priv_app vendor_camera_prop:file read;
allow cameraserver vendor_camera_prop:file read;
