# Defines a new SELinux type for the IMiSys service and marks it as a hardware service manager
type hal_misys_hwservice, hwservice_manager_type;

# Grants the camera app permission to read, open, and execute the vendor's same-process HAL libraries
allow priv_app same_process_hal_file:file { read open getattr execute execute_no_trans map };

# Allows the camera app to find and connect to the IMiSys hardware service we just defined
allow priv_app hal_misys_hwservice:hwservice_manager find;